# Everything is us-east-1. There are no exceptions.
AWS_REGION=us-east-1

# LangSmith on the AWS tenant. The api host, not the default one: a key from
# one instance returns an opaque 401 against the other.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=labcamp-deep-agents-aws
# Only needed for a Service Key (lsv2_sk_...), which is scoped to a workspace.
LANGSMITH_WORKSPACE_ID=
# The board every run lands on. Without it the dossier offers the trace alone,
# which is the link that opens without an account.
LANGSMITH_DASHBOARD_URL=

# Written by the CDK deploy. The bucket holds every table's folder, the agent
# source the page shows read-only, and the pages the browser step reads.
LABCAMP_BUCKET=

# The deployed agent. Set this and the workbench drives AgentCore Runtime
# instead of running the agent in its own process.
LABCAMP_RUNTIME_ARN=

# Optional. Defaults to Haiku 4.5; latency is part of the session design.
# AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
